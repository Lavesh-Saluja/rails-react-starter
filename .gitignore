# Environment files hold local or real credentials. Only .env.example is committed.
.env
.env.*
!.env.example
*.local

# Rails
/.bundle/
/log/
/tmp/
/vendor/bundle/
/config/master.key
/config/credentials/*.key

# JavaScript
node_modules/
/dist/

