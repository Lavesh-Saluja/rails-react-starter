# Copy to .env (git-ignored) only if you need to override defaults.
# Rails loads it in development and test (dotenv); Vite reads it for the dev server and build.

# ---------------------------------------------------------------------------
# Rails: local PostgreSQL. All optional. Leave DB_* unset to use the Unix socket
# with your OS user (peer authentication).
# ---------------------------------------------------------------------------
# Native PostgreSQL over TCP with a password:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=starter
# DB_PASSWORD=change-me
#
# Optional Docker Compose PostgreSQL (compose.yaml):
# DB_HOST=localhost
# DB_PORT=5434
# DB_USERNAME=starter
# DB_PASSWORD=starter_local_only

# Rails server port (the Vite dev proxy expects 3000 by default)
# PORT=3000

# ---------------------------------------------------------------------------
# Frontend.
# WARNING: every VITE_* variable is compiled into the JavaScript bundle and is
# readable by anyone using the site. Never put passwords, tokens, database URLs,
# Rails secrets or other private values in a VITE_* variable.
# ---------------------------------------------------------------------------
# Base URL of the Rails API, without a trailing slash and without /api.
# Leave empty in development (requests go to /api on the Vite server and are proxied).
# In production set it at build time when the API is on another origin.
VITE_API_BASE_URL=

# Development only (read by vite.config.js, not exposed to the browser).
DEV_API_PROXY_TARGET=http://localhost:3000

# ---------------------------------------------------------------------------
# Production only: set these in the hosting platform, never in a committed file.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://user:password@host:5432/dbname
# SECRET_KEY_BASE=   (generate with: bin/rails secret)
# CORS_ORIGINS=https://your-frontend.example.com
# APP_HOSTS=your-api.example.com
# RAILS_LOG_LEVEL=info
# RAILS_FORCE_SSL=true
